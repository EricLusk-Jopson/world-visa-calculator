---
/**
 * Blog index — /blog
 *
 * Pure static Astro page: zero client JavaScript, rendered to plain HTML at
 * build time. Posts come from astro/data/blog-posts.ts: a "Start here" row
 * of featured posts, jump links to each topic, then the posts grouped by
 * topic (newest first within each).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import LandingNav from "../../components/LandingNav.astro";
import Footer from "../../components/Footer.astro";
import {
  BLOG_POSTS,
  BLOG_TOPICS,
  byNewest,
  formatPostDate,
} from "../../data/blog-posts";

const topicLabel = Object.fromEntries(BLOG_TOPICS.map((t) => [t.id, t.label]));
const featured = BLOG_POSTS.filter((p) => p.featured).sort(byNewest);
const sections = BLOG_TOPICS.map((topic) => ({
  ...topic,
  posts: BLOG_POSTS.filter((p) => p.topic === topic.id).sort(byNewest),
}));
---

<BaseLayout
  title="Blog: EuroVisaCalculator"
  description="Guides and articles about Schengen visa rules, the 90/180 rule explained, and travel compliance tips."
  canonicalUrl="https://eurovisacalculator.com/blog"
>
  <LandingNav />

  <main class="blog">
    <div class="blog__inner">
      <p class="blog__tag">Blog</p>
      <h1 class="blog__title">Schengen guides &amp; travel tips</h1>
      <p class="blog__sub">
        Articles on the 90/180-day rule, planning long-term travel, and staying
        compliant.
      </p>

      <nav class="topic-nav" aria-label="Browse by topic">
        <span class="topic-nav__label">Browse by topic</span>
        <ul class="topic-nav__list">
          {sections.map((s) => (
            <li>
              <a href={`#${s.id}`} class="topic-nav__chip">
                {s.label}
                <span class="topic-nav__count">{s.posts.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <section class="featured" aria-labelledby="start-here">
        <h2 id="start-here" class="section__title">Start here</h2>
        <div class="featured__grid">
          {featured.map((post) => (
            <a href={`/blog/${post.slug}`} class="post-card post-card--featured">
              <p class="post-card__tag">{topicLabel[post.topic]}</p>
              <h3 class="post-card__title">{post.title}</h3>
              <p class="post-card__excerpt">{post.excerpt}</p>
              <span class="post-card__read">Read article →</span>
            </a>
          ))}
        </div>
      </section>

      {sections.map((s) => (
        <section id={s.id} class="topic" aria-labelledby={`${s.id}-title`}>
          <div class="topic__head">
            <h2 id={`${s.id}-title`} class="section__title">{s.label}</h2>
            <p class="topic__blurb">{s.blurb}</p>
          </div>
          <ul class="post-list">
            {s.posts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}`} class="post-row">
                  <h3 class="post-row__title">{post.title}</h3>
                  <p class="post-row__excerpt">{post.excerpt}</p>
                  <p class="post-row__meta">
                    <time datetime={post.date}>{formatPostDate(post.date)}</time>
                    {" · "}{post.readMinutes} min read
                  </p>
                </a>
              </li>
            ))}
          </ul>
          <a href="#top" class="topic__top">Back to top ↑</a>
        </section>
      ))}

      <a href="/app" class="blog__cta">Open the calculator →</a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .blog {
    min-height: 100vh;
    background: var(--color-off-white);
    padding: 128px 24px 96px;
  }

  .blog__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .blog__tag {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #00b96b;
    margin: 0 0 12px;
  }

  .blog__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    color: #0c1e3c;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }

  .blog__sub {
    font-family: var(--font-body);
    font-size: 1rem;
    color: #5a6a82;
    line-height: 1.7;
    margin: 0 0 48px;
  }

  /* ── Topic jump links ─────────────────────────────── */
  .topic-nav {
    margin: 0 0 48px;
  }

  .topic-nav__label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5a6a82;
    margin: 0 0 12px;
  }

  .topic-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .topic-nav__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid #e0dbd3;
    border-radius: 999px;
    background: #fff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: #0c1e3c;
    text-decoration: none;
    transition: border-color 0.18s, background 0.18s;
  }

  .topic-nav__chip:hover {
    border-color: #00b96b;
    background: #f2fbf7;
  }

  .topic-nav__count {
    min-width: 20px;
    padding: 1px 6px;
    border-radius: 999px;
    background: #eef1f5;
    font-size: 0.75rem;
    color: #5a6a82;
    text-align: center;
  }

  /* ── Section headings ─────────────────────────────── */
  .section__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    color: #0c1e3c;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
  }

  /* ── Start here (featured) ────────────────────────── */
  .featured {
    margin: 0 0 56px;
  }

  .featured .section__title {
    margin-bottom: 16px;
  }

  .featured__grid {
    display: grid;
    gap: 16px;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    padding: 28px 32px;
    border: 1px solid #e0dbd3;
    border-radius: 14px;
    text-decoration: none;
    background: #fff;
    transition: box-shadow 0.18s, border-color 0.18s, transform 0.18s;
  }

  .post-card--featured {
    border-left: 4px solid #00b96b;
  }

  .post-card:hover {
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
    border-color: #c8c4bc;
    border-left-color: #00b96b;
    transform: translateY(-1px);
  }

  .post-card__tag {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #00b96b;
    margin: 0 0 10px;
  }

  .post-card__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    color: #0c1e3c;
    line-height: 1.35;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }

  .post-card__excerpt {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.7;
    color: #5a6a82;
    margin: 0 0 18px;
  }

  .post-card__read {
    margin-top: auto;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: #0c1e3c;
  }

  /* ── Topic sections ───────────────────────────────── */
  .topic {
    margin: 0 0 48px;
    scroll-margin-top: 96px;
  }

  .topic__head {
    padding-bottom: 14px;
    border-bottom: 1px solid #e0dbd3;
  }

  .topic__blurb {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: #5a6a82;
    margin: 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
  }

  .post-list li {
    border-bottom: 1px solid #e0dbd3;
  }

  .post-row {
    display: block;
    padding: 20px 4px;
    text-decoration: none;
  }

  .post-row__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 400;
    color: #0c1e3c;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    transition: color 0.18s;
  }

  .post-row:hover .post-row__title {
    color: #00915a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-row__excerpt {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: #5a6a82;
    margin: 0 0 8px;
  }

  .post-row__meta {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: #8592a6;
    margin: 0;
  }

  .topic__top {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: #5a6a82;
    text-decoration: none;
  }

  .topic__top:hover {
    color: #0c1e3c;
  }

  @media (max-width: 600px) {
    .post-card {
      padding: 22px 20px;
    }
  }

  .blog__cta {
    display: flex;
    width: fit-content;
    margin: 0 auto;
    padding: 12px 28px;
    background: #00b96b;
    color: #fff;
    border-radius: 10px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.18s;
  }

  .blog__cta:hover {
    background: #009e5a;
  }
</style>
