---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingNav from "../components/LandingNav.astro";
import Footer from "../components/Footer.astro";
/**
 * Changelog entries, most recent first. Each `changes` array holds
 * { tag: "feature" | "improvement" | "fix", text: string }.
 */
const roadmapCountries = [
  { name: "Cyprus", done: true },
  { name: "Albania", done: true },
  { name: "Montenegro", done: true },
  { name: "North Macedonia", done: true },
  { name: "Kosovo", done: true },
  { name: "Bosnia and Herzegovina", done: true },
  { name: "Serbia", done: true },
  { name: "Belarus", done: true },
  { name: "Georgia", done: true },
  { name: "Armenia", done: true },
  { name: "Ukraine", done: false },
  { name: "Moldova", done: false },
  { name: "Azerbaijan", done: false },
  { name: "Morocco", done: false },
  { name: "Algeria", done: false },
  { name: "Tunisia", done: false },
  { name: "Egypt", done: false },
];

const qcPipelineGoals = [
  { text: "Every government source cited in the app is checked automatically every two weeks, for broken links and changed content.", done: true },
  { text: "Flagged changes are reviewed by a person against the live source before any rule is updated.", done: true },
  { text: "Every rule change is logged publicly with what prompted it and the evidence behind it.", done: true },
  { text: "Each source shows when it was last verified and links to any rule change it backs.", done: true },
  { text: "A “Report a problem” form on every source for flagging broken links or outdated information.", done: true },
  { text: "Machine checks for the sources that still need a person to read them (some government sites block automated checks or only show their rules inside interactive forms).", done: false },
];

const changelog = [
  {
    range: "September 25 to October 8, 2026",
    changes: [
      { tag: "feature", text: "Added Armenia as a trackable destination, covering both its unilateral visa free list and its bilateral visa free agreements under a shared 180 day in 365 rolling window." },
      { tag: "improvement", text: "Shared trips (the same trip logged for multiple travelers) now highlight together across timeline columns on hover, and editing one updates all travelers at once." },
      { tag: "improvement", text: "Published a new blog post testing how well Claude, ChatGPT, and Gemini handle Schengen 90/180 calculations against the official EU method." },
      { tag: "improvement", text: "Added internal links from every blog post to the rolling window explainer." },
    ],
  },
  {
    range: "September 11 to 24, 2026",
    changes: [
      { tag: "feature", text: "Added Belarus and Georgia as trackable destinations: Belarus with a temporary any border override through the end of 2026 that falls back to airport only access, Georgia with up to a full year of visa free stay for most nationalities." },
      { tag: "feature", text: "Added the five de facto Schengen members (Andorra, Gibraltar, Monaco, San Marino, and Vatican City), tracked under the same 90/180 rule as formal member states." },
      { tag: "improvement", text: "Published a new blog post on where our visa data comes from and how it's kept current, and repointed the homepage's “Why Accuracy Matters” link to it." },
      { tag: "improvement", text: "Restyled the 90/180 rolling window blog post's interactive panels to match the homepage's explainer card." },
      { tag: "improvement", text: "Refined trip card title typography and added responsive column widths to the desktop timeline." },
      { tag: "fix", text: "Fixed calculator app headings silently falling back to the system font instead of the site's Plus Jakarta Sans typeface." },
    ],
  },
  {
    range: "August 28 to September 10, 2026",
    changes: [
      { tag: "feature", text: "Added Montenegro, Serbia, Bosnia and Herzegovina, Kosovo, North Macedonia, Albania, and Cyprus as trackable destinations, each with passport aware entry rules and stay limit tracking." },
      { tag: "improvement", text: "Consolidated the destination region list into a single source of truth, with every region citing its government source directly on the rule summary." },
      { tag: "improvement", text: "Added an “All” button to the mobile trip form's Travelers card." },
      { tag: "improvement", text: "Published a new blog post on when your Schengen allowance resets." },
    ],
  },
  {
    range: "August 14 to 27, 2026",
    changes: [
      { tag: "feature", text: "Added a generic per destination status engine that unifies day tracking (sliders, chips, notes) across Schengen, UK, Ireland, and Türkiye, with a per traveler destination override." },
      { tag: "improvement", text: "Added “no save” shareable links, so a link posted publicly (blogs, forums, social) won't overwrite a reader's own saved trips." },
      { tag: "improvement", text: "Added session IDs to anonymous usage analytics for more accurate tracking." },
      { tag: "improvement", text: "Published a new blog post on tracking Schengen days for couples." },
    ],
  },
  {
    range: "July 31 to August 13, 2026",
    changes: [
      { tag: "feature", text: "Introduced a centralized passport rule data layer that unifies Schengen, UK, Ireland, and Türkiye visa rule lookups behind a single function." },
      { tag: "improvement", text: "Desktop trip modal now shows each traveler's eligibility and remaining duration in an overlay matching the modal's design." },
      { tag: "improvement", text: "Added Türkiye to the desktop region selector." },
      { tag: "improvement", text: "Redesigned the mobile Trip Detail view around traveler cards, with “Entry” and “Duration” status groups." },
      { tag: "improvement", text: "Capped the mobile traveler list at half screen with scroll, and removed passport flags from traveler rows." },
      { tag: "fix", text: "Reclassified nine Türkiye nationalities from a fixed 6 month window to the standard 90/180 rolling window for consistency with the rest of the ruleset." },
    ],
  },
  {
    range: "July 17 to 30, 2026",
    changes: [],
  },
  {
    range: "July 3 to 16, 2026",
    changes: [],
  },
  {
    range: "June 19 to July 2, 2026",
    changes: [
      { tag: "feature", text: "UK and Ireland now warn as you approach or exceed max stay limits, and flag re entry patterns that risk extra scrutiny." },
      { tag: "feature", text: "Added Türkiye as a fourth trackable region; rebuilt the visa rule engine to support per visit, rolling window, fixed window, and calendar period stay limits across 195+ nationalities." },
      { tag: "feature", text: "Shipped a fully mobile optimized UI: a slide in trip detail panel, an add traveler drawer, and a utility drawer for touch devices." },
      { tag: "improvement", text: "Published a new blog post explaining the 90/180 rolling window." },
    ],
  },
  {
    range: "June 5 to 18, 2026",
    changes: [],
  },
  {
    range: "May 22 to June 4, 2026",
    changes: [
      { tag: "feature", text: "Added the UK and Ireland as trackable destinations, each with their own entry rules (ETA/DATV for the UK; visa free/BIVS/SSVWP for Ireland) shown in the trip modal." },
      { tag: "improvement", text: "Added a Schengen member tooltip across the UI." },
      { tag: "improvement", text: "Added tooltips and highlighting for the current/next trip on trip cards." },
      { tag: "improvement", text: "The “Currently in …” label now reflects the correct region (Ireland, UK, or Schengen)." },
      { tag: "improvement", text: "Removed inaccurate ETA cost information from UK guidance." },
      { tag: "fix", text: "Fixed trip card chip wrapping and text overflow." },
    ],
  },
  {
    range: "May 8 to 21, 2026",
    changes: [
      { tag: "improvement", text: "Published a new blog post on whether your entry and exit days count toward your Schengen allowance." },
      { tag: "improvement", text: "Added a “no save” URL parameter for blog example links, so readers exploring an example don't overwrite their own trip data." },
    ],
  },
  {
    range: "April 24 to May 7, 2026",
    changes: [],
  },
  {
    range: "April 10 to 23, 2026",
    changes: [
      { tag: "fix", text: "Hid day tracking for passport holders who require a Schengen visa, since the 90/180 counter doesn't apply to them." },
    ],
  },
  {
    range: "March 27 to April 9, 2026",
    changes: [
      { tag: "feature", text: "Launched passport aware Schengen guidance: a nationality selector (195+ countries) that automatically shows free movement, visa free, visa required, or suspended status, plus ETIAS notices where relevant." },
      { tag: "improvement", text: "Rebuilt the site on Astro with a new design system, hero calculator, and pure CSS nav." },
      { tag: "improvement", text: "Added the Privacy Policy page and a buffer day disclaimer." },
      { tag: "improvement", text: "Added a Kofi support link and anonymous usage analytics." },
      { tag: "improvement", text: "Published our first blog post." },
      { tag: "improvement", text: "Corrected the Schengen member count from 26 to 29." },
      { tag: "improvement", text: "Added aging out indicators for past trips on the timeline." },
      { tag: "fix", text: "Fixed mobile timeline markers and tooltips." },
    ],
  },
];

const tagLabel: Record<string, string> = {
  feature: "Feature",
  improvement: "Improvement",
  fix: "Fix",
};
---

<BaseLayout
  title="Updates | EuroVisaCalculator"
  description="What's next for EuroVisaCalculator, and a changelog of everything shipped since launch."
  canonicalUrl="https://eurovisacalculator.com/updates"
>
  <LandingNav />
  <div class="page">
    <div class="page__inner">
      <h1 class="page__title">Updates</h1>
      <p class="page__date">Tracking changes since launch: March 26, 2026</p>

      <section class="section">
        <h2 class="section__title">Roadmap</h2>
        <p class="section__body">Two workstreams are currently in progress:</p>

        <div class="roadmap-card">
          <p class="roadmap-card__label">In progress: full European &amp; neighbouring coverage</p>
          <p class="roadmap-card__desc">
            Expanding destination support to cover all of Europe and its
            neighbouring nations. Each new destination gets its own entry
            rules and stay limit tracking, powered by the same status engine
            that drives every destination the app already covers.
          </p>
          <ul class="roadmap-card__list">
            {roadmapCountries.map((country) => (
              <li class={country.done ? "is-done" : ""}>
                {country.name}
                {country.done && <span class="roadmap-card__check" aria-hidden="true">✓</span>}
              </li>
            ))}
          </ul>
        </div>

        <div class="roadmap-card">
          <p class="roadmap-card__label">In progress: data QC &amp; error reporting pipeline</p>
          <p class="roadmap-card__desc">
            An automated pipeline that keeps passport and destination rules
            accurate as government sources change, backed by a way for users
            to flag problems directly:
          </p>
          <ul class="roadmap-card__goals">
            {qcPipelineGoals.map((goal) => (
              <li class={goal.done ? "is-done" : ""}>
                <span class="roadmap-card__mark" aria-hidden="true">{goal.done ? "✓" : "○"}</span>
                <span>{goal.text}</span>
                <span class="visually-hidden">{goal.done ? " (done)" : " (in progress)"}</span>
              </li>
            ))}
          </ul>
          <a class="roadmap-card__link" href="/rule-changes">See every rule change →</a>
        </div>
      </section>

      <section class="section">
        <h2 class="section__title">Changelog</h2>
        <div class="changelog">
          {changelog.map((entry) => (
            <div class="changelog-entry">
              <p class="changelog-entry__range">{entry.range}</p>
              {entry.changes.length === 0 ? (
                <p class="changelog-entry__empty">No changes shipped this period.</p>
              ) : (
                <ul class="changelog-entry__list">
                  {entry.changes.map((change) => (
                    <li class="changelog-entry__item">
                      <span class={`tag tag--${change.tag}`}>{tagLabel[change.tag]}</span>
                      <span>{change.text}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-off-white);
    padding: 128px 24px 96px;
  }

  .page__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .page__title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-navy);
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .page__date {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-text-ghost);
    margin: 0 0 48px;
  }

  .section {
    margin-bottom: 48px;
  }

  .section__title {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .section__body {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-soft);
    margin: 0 0 20px;
  }

  /* ── Roadmap ─────────────────────────────────────────────────────────── */
  .roadmap-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 24px 28px;
  }

  .roadmap-card + .roadmap-card {
    margin-top: 16px;
  }

  .roadmap-card__label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-green-text);
    margin: 0 0 12px;
  }

  .roadmap-card__desc {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-soft);
    margin: 0 0 16px;
  }

  .roadmap-card__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--color-text);
  }

  @media (min-width: 480px) {
    .roadmap-card__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .roadmap-card__list li.is-done {
    color: var(--color-text-ghost);
  }

  .roadmap-card__check {
    margin-left: 4px;
    color: var(--color-green-text);
    font-weight: 700;
  }

  .roadmap-card__goals {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .roadmap-card__goals li {
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 8px;
    align-items: baseline;
  }

  .roadmap-card__mark {
    color: var(--color-text-ghost);
    font-weight: 700;
    text-align: center;
  }

  .roadmap-card__goals li.is-done .roadmap-card__mark {
    color: var(--color-green-text);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .roadmap-card__link {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: none;
  }

  .roadmap-card__link:hover {
    text-decoration: underline;
  }

  /* ── Changelog ───────────────────────────────────────────────────────── */
  .changelog-entry {
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
  }

  .changelog-entry:last-child {
    padding-bottom: 0;
  }

  .changelog-entry__range {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 12px;
  }

  .changelog-entry__empty {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-text-ghost);
    font-style: italic;
    margin: 0;
  }

  .changelog-entry__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .changelog-entry__item {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-soft);
    display: grid;
    grid-template-columns: 100px 1fr;
    align-items: baseline;
    column-gap: 10px;
  }

  .tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 6px;
    line-height: 1.6;
    text-align: center;
  }

  .tag--feature {
    background: var(--color-green-bg);
    color: var(--color-green-text);
    border: 1px solid var(--color-green-border);
  }

  .tag--improvement {
    background: var(--color-mist);
    color: var(--color-navy-mid);
    border: 1px solid var(--color-border);
  }

  .tag--fix {
    background: var(--color-amber-bg);
    color: var(--color-amber-text);
    border: 1px solid var(--color-amber-border);
  }
</style>
