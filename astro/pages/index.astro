<style>
  /* ── Hero layout ────────────────────────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  @media (min-width: 900px) {
    .hero {
      flex-direction: row;
    }
  }

  /* ── Left column ────────────────────────────────────────────────────────── */
  .hero__left {
    padding: 60px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
  }

  @media (min-width: 900px) {
    .hero__left {
      flex: 1;
      padding: 80px 80px;
    }
  }

  /* Center the hero content (title, description, CTA, proof items) as a
     block on mobile. Desktop keeps the left-aligned layout. */
  @media (max-width: 899px) {
    .hero__left {
      align-items: center;
      text-align: center;
    }
  }

  /* ── Right column ──────────────────────────────────────────────────────── */
  .hero__right {
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
  }

  @media (min-width: 900px) {
    .hero__right {
      flex: 1;
      border-top: none;
      border-left: 1px solid var(--color-border);
      padding: 80px 60px;
    }
  }

  /* ── Eyebrow badge ──────────────────────────────────────────────────────── */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-green);
    background: var(--color-green-bg);
    padding: 5px 14px;
    border-radius: 100px;
    width: fit-content;
    border: 1px solid var(--color-green-border);
    animation: fadeUp 0.5s 0.1s both ease-out;
  }

  /* Eyebrow is desktop-only it wraps awkwardly at narrow widths and the
     hero CTA button below covers the same "free / private / no
     account" messaging via the CTA band further down the page. */
  @media (max-width: 899px) {
    .eyebrow {
      display: none;
    }
  }

  /* ── Hero CTA ───────────────────────────────────────────────────────────── */
  /* Double class for specificity: must beat .btn-green's own unconditional
     `display: inline-flex`, which is declared later in this stylesheet.
     Visible at every width now the visitor shouldn't have to interact with
     the map before opening the app; centered to match the centered hero
     copy on mobile, left-aligned to match it on desktop. */
  .hero__cta.btn-green {
    display: flex;
    justify-content: center;
    width: fit-content;
    padding: 16px 32px;
    font-size: 1.05rem;
    animation: fadeUp 0.6s 0.35s both ease-out;
  }

  @media (max-width: 899px) {
    .hero__cta.btn-green {
      margin-left: auto;
      margin-right: auto;
    }
  }

  .eyebrow__dot {
    width: 7px;
    height: 7px;
    background: var(--color-green);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── Heading ────────────────────────────────────────────────────────────── */
  .hero__h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 4.5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.12;
    color: var(--color-navy);
    letter-spacing: -0.01em;
    margin: 0;
    animation: fadeUp 0.6s 0.2s both ease-out;
  }

  .hero__h1 em {
    font-style: italic;
    color: var(--color-green);
  }

  /* ── Sub-copy ───────────────────────────────────────────────────────────── */
  .hero__sub {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-soft);
    max-width: 440px;
    margin: 0;
    animation: fadeUp 0.6s 0.3s both ease-out;
  }

  /* ── Proof items ────────────────────────────────────────────────────────── */
  .proof-items {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    animation: fadeUp 0.6s 0.4s both ease-out;
  }

  /* Centering the box (.hero__left) doesn't center the wrapped items
     inside this flex row that needs its own justify-content. */
  @media (max-width: 899px) {
    .proof-items {
      justify-content: center;
    }
  }

  .proof-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-text-soft);
  }

  .proof-item svg {
    color: var(--color-green);
    flex-shrink: 0;
  }

  /* ── Shared fade-up animation ───────────────────────────────────────────── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Trust strip ────────────────────────────────────────────────────────── */
  .trust-strip {
    background: var(--color-navy);
    padding: 60px 24px;
    position: relative;
    overflow: hidden;
  }

  .trust-strip::before {
    content: "";
    position: absolute;
    top: -150px;
    left: -150px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 185, 107, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .trust-strip {
      padding: 100px 80px;
    }
  }

  .trust-strip__grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .trust-strip__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
  }

  .trust-stat {
    display: flex;
    flex-direction: column;
