---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingNav from "../components/LandingNav.astro";
import { HeroCalculatorIsland } from "@/islands/HeroCalculatorIsland";
import { EuropeCoverageIsland } from "@/islands/EuropeCoverageIsland";
---

<BaseLayout
  title="EuroVisaCalculator: Schengen, UK, Ireland & Türkiye Visa Tracker"
  description="Check visa-free entry and track day allowances across Schengen, the UK, Ireland, and Türkiye, for any passport and every traveler in your group. Free, no account required."
>
  <LandingNav />

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <!-- Left column — static copy -->
    <div class="hero__left">
      <!-- Eyebrow badge -->
      <div class="eyebrow">
        <span class="eyebrow__dot"></span>
        Free · Private · No account required · Works instantly
      </div>

      <!-- Heading -->
      <h1 class="hero__h1">
        Travel Europe indefinitely, <em>without the overstay risk.</em>
      </h1>

      <!-- Sub-copy -->
      <p class="hero__sub">
        Check visa and entry requirements for Schengen, the UK, Ireland, and
        Türkiye, for any passport and any traveler. Add trips, see remaining
        days, and plan without guessing.
      </p>

      <!-- Mobile-only CTA — the interactive calculator demo is hidden on
           mobile, so this replaces it as the primary call to action. -->
      <a href="/app" class="btn-green hero__mobile-cta">
        Open the calculator →
      </a>

      <!-- Proof items -->
      <div class="proof-items">
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1L9.8 5.8L15 6.2L11.2 9.6L12.4 15L8 12.4L3.6 15L4.8 9.6L1 6.2L6.2 5.8L8 1Z" />
          </svg>
          Official Schengen rolling-window algorithm
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8C2 4.686 4.686 2 8 2s6 2.686 6 6-2.686 6-6 6-6-2.686-6-6z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5.5 8l2 2L11 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Multiple travelers, one view
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M2 8C2 4.686 4.686 2 8 2s6 2.686 6 6-2.686 6-6 6-6-2.686-6-6z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          URL-shareable results
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="4" y="7" width="8" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Your data never leaves your device
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2l1.5 4.5H14l-3.75 2.75L11.5 14 8 11.25 4.5 14l1.25-4.75L2 6.5h4.5L8 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          </svg>
          Entry rules for 198 passports
        </span>
      </div>
    </div>

    <!-- Right column — interactive calculator card -->
    <div class="hero__right">
      <HeroCalculatorIsland client:visible />
    </div>
  </section>

  <!-- ── FEATURES ─────────────────────────────────────────────────────────── -->
  <section id="features" class="features">
    <div class="features__inner">
      <!-- Left column -->
      <div class="features__left">
        <p class="section-tag section-tag--light">Features</p>
        <h2 class="section-heading section-heading--light">
          Built for long-term,<br />
          frequent, and <em>social travelers.</em>
        </h2>
        <p class="section-sub section-sub--light">
          Most travel calculators only handle a single traveler, on a single
          trip, to a single country, with no way to check whether your
          passport even qualifies for visa-free entry. We built this for
          real, long-term, multi-country travel.
        </p>
        <a href="/app" class="btn-green" style="margin-top:36px;">
          Try it free →
        </a>
      </div>

      <!-- Right column — feature list -->
      <div class="features__right">
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 9C2 5.134 5.134 2 9 2s7 3.134 7 7-3.134 7-7 7-7-3.134-7-7z" stroke="currentColor" stroke-width="1.4"/>
              <path d="M5.5 9l2.5 2.5L13 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Official rules for every destination</p>
            <p class="feature-item__desc">Schengen, Türkiye, and the Balkan and Mediterranean destinations we track all share the same 90/180 rolling-window rule, which we implement exactly: any 180-day lookback, counting both entry and exit days, verified against the official EU calculator. The UK and Ireland each use their own per-visit rules instead, which we support too.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="10" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="2" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="10" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Multiple travelers, one dashboard</p>
            <p class="feature-item__desc">Track couples, families, or groups of travelers from different countries of origin, each with their own schedule, in a single shared view. Shareable via URL.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M9 2v4M9 12v4M2 9h4M12 9h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Earliest return date calculator</p>
            <p class="feature-item__desc">After leaving, see the earliest date you can return for a given number of days. Stops you booking flights that will get rejected at the border.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="4" y="2" width="10" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="9" cy="7" r="1.8" stroke="currentColor" stroke-width="1.4"/>
              <path d="M6.5 12h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Visa &amp; entry requirements, per passport</p>
            <p class="feature-item__desc">Every traveler's passport is checked against each destination's rules: visa requirements, pre-travel authorizations like ETIAS or an ETA, and maximum stay lengths. Restrictions are flagged before you book, not after.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 9.5l5-5 3 4 3-3 3 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Live validation &amp; overstay warnings</p>
            <p class="feature-item__desc">Calendar cells are color-coded as you pick dates: green for safe, yellow for caution, red for over the limit. Alerts fire before you save a trip that would push you over the limit, so there are no surprises after you click confirm.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="4" y="8" width="10" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M6.5 8V6a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Completely private, no backend</p>
            <p class="feature-item__desc">Your trips are saved in your browser's local storage and encoded in the URL. No account needed and no server ever sees your travel history. Works offline once the app is loaded. Share the link and everyone you're traveling with sees exactly what you see.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ─────────────────────────────────────────────────────── -->
  <section id="how" class="how">
    <div class="how__inner">
      <p class="section-tag">How it works</p>
      <h2 class="section-heading">
        Simple enough to use<br />
        in <em>thirty seconds.</em>
      </h2>
      <p class="section-sub">
        No spreadsheets. No manual math. Just add your trips and get a clear answer.
      </p>

      <div class="steps-grid">
        <!-- Step 01 -->
        <div class="step-card">
          <span class="step-card__num">01</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="7" r="3" stroke="currentColor" stroke-width="1.5"/>
              <path d="M4 17c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Add your travelers</h3>
          <p class="step-card__desc">Enter names for everyone you want to track: yourself, a partner, family, or a group of friends.</p>
        </div>
        <!-- Step 02 -->
        <div class="step-card step-card--border-left">
          <span class="step-card__num">02</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="3" y="4" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 9h14" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7 2v4M13 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Add Your Trips</h3>
          <p class="step-card__desc">Add each trip to the destination it belongs to, with an entry and exit date. Planned future trips show up too.</p>
        </div>
        <!-- Step 03 -->
        <div class="step-card step-card--border-left">
          <span class="step-card__num">03</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 6v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Check Your Compliance</h3>
          <p class="step-card__desc">See visa eligibility, duration limits, and overstay risk for every traveler, updated instantly as you add trips.</p>
        </div>
        <!-- Step 04 -->
        <div class="step-card step-card--border-left">
          <span class="step-card__num">04</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="15" cy="5" r="2" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="5" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="15" cy="15" r="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M6.8 9l6.4-3M6.8 11l6.4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Share Your Results</h3>
          <p class="step-card__desc">Copy the link and send it to everyone you're traveling with. They'll see exactly what you see, with no login required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── TRUST STRIP ──────────────────────────────────────────────────────── -->
  <section class="trust-strip" aria-label="Key statistics">
    <div class="trust-strip__grid">
      <div class="trust-stat">
        <span class="trust-stat__num">4</span>
        <span class="trust-stat__label">official rule systems<br />one calculator</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat__num">39</span>
        <span class="trust-stat__label">European destinations<br />and counting</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat__num">198</span>
        <span class="trust-stat__label">passports<br />with entry rules covered</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat__num">0</span>
        <span class="trust-stat__label">bytes of your data<br />sent to any server</span>
      </div>
    </div>
  </section>

  <!-- ── EUROPE COVERAGE MAP ──────────────────────────────────────────────── -->
  <section id="coverage" class="coverage">
    <div class="coverage__inner">
      <p class="section-tag">Where it works</p>
      <h2 class="section-heading">
        Europe, <em>at a glance.</em>
      </h2>
      <p class="section-sub">
        Explore all 39 supported countries. Schengen is one shared travel
        area; non-Schengen countries use their own compliance rules. Select
        a destination to see its visa-free stay rule.
      </p>
      <div class="coverage__map">
        <EuropeCoverageIsland client:visible calculatorHref="/app" />
      </div>
    </div>
  </section>

  <!-- ── RULES EXPLAINER ──────────────────────────────────────────────────── -->
  <section id="rules" class="rules">
    <div class="rules__inner">
      <!-- Left: text -->
      <div class="rules__text">
        <p class="section-tag">The 90/180 Rule</p>
        <h2 class="section-heading section-heading--light">
          It's not "90 days<br />
          then leave for 90." <em>It's more complex.</em>
        </h2>
        <p class="section-sub section-sub--light">
          The 90/180 is most often mentioned in reference to the Schengen
          Area, but it's far from unique to Schengen. In fact, the rule is
          enforced across most European countries, even outside the Schengen
          block, so it's worth understanding.
        </p>
        <p class="rules__body">
          The rule applies to a rolling 180-day window. At any given moment,
          look back 180 days. If you've spent 90 or more days inside during
          that window, you've overstayed. As time passes, old trips begin to
          fall outside of the window and no longer count against your
          allowance.
        </p>
        <p class="rules__body">
          To better understand the rule, read our
          <a href="/blog/the-schengen-90-180-rolling-window">full guide to the 90/180 rolling window</a>
          for a walkthrough of real scenarios.
        </p>
      </div>

      <!-- Right: interactive demo (same widget/scenario as the blog's "90 days out, 90 days back" example) -->
      <div class="schengen-explorer" data-scenario="0">
        <h3 class="sr-only">Interactive Schengen rolling window explorer — two 90-day trips</h3>
        <div class="scenario-label"></div>
        <div class="timeline-outer"><canvas height="200"></canvas></div>
        <div class="controls">
          <div class="ctrl-row">
            <span class="ctrl-label">Window end date</span>
            <input type="range" min="0" max="100" value="50" step="1" />
            <span class="window-date-label"></span>
          </div>
        </div>
        <div class="stats-wrap"><div class="stats-container"></div></div>
      </div>
    </div>
  </section>

  <!-- ── OVERSTAY RISK ─────────────────────────────────────────────────────── -->
  <section id="overstay-risk" class="risk">
    <div class="risk__inner">
      <p class="section-tag">Why Accuracy Matters</p>
      <h2 class="section-heading">
        Get the math wrong,<br />
        and <em>you've overstayed.</em>
      </h2>
      <p class="section-sub">
        A single miscalculation can push you past your allowance without
        anyone noticing until it's too late — and the consequences don't end
        when the trip does.
      </p>

      <div class="risk-grid">
        <div class="risk-card">
          <div class="risk-card__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M9 2.5L16.5 15.5H1.5L9 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              <path d="M9 7v3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="9" cy="13" r="0.9" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="risk-card__title">Overstaying has real consequences</h3>
          <p class="risk-card__desc">Even a single extra day can mean fines, an automatic entry ban lasting months or years, and a flag on your record that follows you to every Schengen border, not just the one where it happened.</p>
        </div>
        <div class="risk-card">
          <div class="risk-card__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M3 3h3M3 3v3M15 3h-3M15 3v3M3 15h3M3 15v-3M15 15h-3M15 15v-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="9" cy="9" r="2.4" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </div>
          <h3 class="risk-card__title">EES is closing the gap</h3>
          <p class="risk-card__desc">The EU's incoming Entry/Exit System replaces manual passport stamps with automated, biometric logging of every entry and exit. Once it's fully rolled out, there's no more benefit of the doubt: every day is recorded, and overstays are flagged automatically.</p>
        </div>
        <div class="risk-card">
          <div class="risk-card__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 4.5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7l-3.5 3v-3H4a2 2 0 0 1-2-2v-6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              <path d="M6.5 7.3c0-1 .8-1.8 2-1.8s2 .6 2 1.6c0 .9-.6 1.2-1.2 1.6-.5.3-.8.6-.8 1.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="8.5" cy="11.8" r="0.9" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="risk-card__title">AI doesn't calculate this, it guesses</h3>
          <p class="risk-card__desc">Ask a chatbot when you can return, how long you must wait before a 30-day trip, or by what date you need to leave, and it will confidently answer, often incorrectly. These are rolling-window calculations over a real itinerary. General-purpose AI doesn't run that algorithm; it predicts plausible-sounding text, not verified compliance math.</p>
        </div>
      </div>

      <a href="/app" class="btn-green" style="margin-top:40px;">
        Calculate your real dates →
      </a>
    </div>
  </section>

  <!-- ── CTA BAND ─────────────────────────────────────────────────────────── -->
  <section class="cta-band">
    <div class="cta-band__inner">
      <h2 class="cta-band__heading">
        Stop guessing.<br />
        Start tracking <em>in seconds.</em>
      </h2>
      <p class="cta-band__sub">
        Free, no account required. Your trip data is stored in your browser,
        never on our servers. Add travelers, enter your trips, and share
        a link with everyone you're traveling with, immediately.
      </p>
      <div class="cta-band__actions">
        <a href="/app" class="btn-green">
          Open the calculator →
        </a>
        <a href="/blog" class="btn-ghost">
          Read our guides →
        </a>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ────────────────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="footer__inner">
      <div class="footer__top">
        <div class="footer__identity">
          <span class="footer__brand">EuroVisaCalculator</span>
          <a
            href="https://ko-fi.com/ericluskjopson"
            class="footer__kofi"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/>
            </svg>
            Support This Project
          </a>
        </div>
        <nav class="footer__links" aria-label="Footer navigation">
          <a href="/privacy" class="footer__link">Privacy</a>
          <a href="/updates" class="footer__link">Updates</a>
          <a href="/blog" class="footer__link">Blog</a>
          <a href="#how" class="footer__link">How it works</a>
          <a href="/app" class="footer__link">Calculator</a>
        </nav>
      </div>
      <p class="footer__disclaimer">
        For informational use only. Always verify with official government sources
        before making travel decisions.
        Not legal advice. Entry and visa rules vary by nationality and destination.
      </p>
    </div>
  </footer>
</BaseLayout>

<!--
  Interactive rolling-window demo for the 90/180 Rule section — the same
  widget used in the blog post "The Schengen 90/180 Rolling Window",
  scoped down to just the "90 days out, 90 days back" two-trip scenario
  since this page only needs the one instance.
-->
<script>
  (function () {
    function d(y: number, m: number, day: number) { return new Date(y, m - 1, day); }
    function addDays(dt: Date, n: number) { const r = new Date(dt); r.setDate(r.getDate() + n); return r; }
    function diffDays(a: Date, b: Date) { return Math.round((b.getTime() - a.getTime()) / 86400000); }
    function fmtDate(dt: Date) { return dt.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); }
    function fmtShort(dt: Date) {
      const M = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
      return M[dt.getMonth()] + " " + String(dt.getDate()).padStart(2, "0");
    }

    const PAD = 195;

    interface Trip { start: Date; end: Date; label: string; color: string; person: string; showLabel?: boolean; }

    interface Scenario {
      id: string; label: string;
      desc: string; trips: Trip[]; windowDefault: Date;
    }

    const SCENARIOS: Scenario[] = [
      {
        id: "s3", label: "90 days out, 90 days back",
        desc: "Two 90-day trips to the Schengen Area: Mar 1–May 29, then Sep 7–Dec 5. <em>Drag the slider to move the 180-day window's end date. Days from either trip that fall inside the shaded band count toward the 90-day limit shown below.</em>",
        trips: [
          { start: d(2025, 3, 1), end: d(2025, 5, 29),  label: "Trip 1", color: "#378add", person: "p" },
          { start: d(2025, 9, 7), end: d(2025, 12, 5),  label: "Trip 2", color: "#1d9e75", person: "p" },
        ],
        windowDefault: d(2025, 9, 7),
      },
    ];

    function initExplorer(container: HTMLElement) {
      const scenarioIdx = parseInt(container.dataset.scenario ?? "0") || 0;
      const isDark = matchMedia("(prefers-color-scheme: dark)").matches;

      const descEl      = container.querySelector<HTMLElement>(".scenario-label")!;
      const canvas      = container.querySelector<HTMLCanvasElement>("canvas")!;
      const slider      = container.querySelector<HTMLInputElement>("input[type=range]")!;
      const dateLabelEl = container.querySelector<HTMLElement>(".window-date-label")!;
      const statsEl     = container.querySelector<HTMLElement>(".stats-container")!;
      const ctx         = canvas.getContext("2d")!;

      const currentScenario: Scenario = SCENARIOS[scenarioIdx];
      let TL_START: Date, TL_END: Date, TL_TOTAL: number;

      function computeRange(trips: Trip[]) {
        const mn = trips.reduce((a, t) => (t.start < a ? t.start : a), trips[0].start);
        const mx = trips.reduce((a, t) => (t.end > a ? t.end : a), trips[0].end);
        return { start: addDays(mn, -PAD), end: addDays(mx, PAD) };
      }

      function countAll(trips: Trip[], windowEnd: Date) {
        const windowStart = addDays(windowEnd, -179);
        let count = 0;
        trips.forEach((t) => {
          const os = t.start > windowStart ? t.start : windowStart;
          const oe = t.end < windowEnd ? t.end : windowEnd;
          if (oe >= os) count += diffDays(os, oe) + 1;
        });
        return count;
      }

      function renderStats(trips: Trip[], windowEnd: Date) {
        const days = countAll(trips, windowEnd);
        const remaining = Math.max(0, 90 - days);
        statsEl.innerHTML = `
          <div class="stats-single">
            <div class="stat-card">
              <div class="stat-label">Days in window</div>
              <div class="stat-val ${days > 90 ? "danger" : days > 70 ? "warn" : "ok"}">${days}</div>
            </div>
            <div class="stat-card">
              <div class="stat-label">Remaining allowance</div>
              <div class="stat-val ${remaining === 0 ? "danger" : remaining < 20 ? "warn" : "ok"}">${remaining}</div>
            </div>
          </div>`;
      }

      function drawTimeline(windowEnd: Date) {
        const trips = currentScenario.trips;
        const W = canvas.width;
        const mL = 10, mR = 10, mTop = 28;
        const tripH = 20, tripGap = 5;
        const plotW = W - mL - mR;
        const windowStart = addDays(windowEnd, -179);

        const xOf = (dt: Date) => mL + (diffDays(TL_START, dt) / TL_TOTAL) * plotW;

        const rowAssign = new Array(trips.length).fill(0);
        const rowEnds: (Date | undefined)[] = [];
        let numRows = 1;
        trips.forEach((t, i) => {
          let r = 0;
          while (rowEnds[r] !== undefined && rowEnds[r]! >= t.start) r++;
          rowAssign[i] = r;
          rowEnds[r] = t.end;
          if (r + 1 > numRows) numRows = r + 1;
        });
        const getTripRow = (_t: Trip, i: number) => rowAssign[i];

        const totalTripH = numRows * tripH + (numRows - 1) * tripGap;
        const tripAreaTop = mTop + 20;
        const axisY = tripAreaTop + totalTripH + 16;
        canvas.height = axisY + 22;

        ctx.clearRect(0, 0, W, canvas.height);

        const refOver = countAll(trips, windowEnd) > 90;

        const x0w = Math.max(mL, xOf(windowStart));
        const x1w = Math.min(W - mR, xOf(addDays(windowEnd, 1)));

        // Window overlay
        ctx.fillStyle = refOver
          ? isDark ? "rgba(163,45,45,0.18)" : "rgba(240,149,149,0.15)"
          : isDark ? "rgba(55,138,221,0.12)" : "rgba(55,138,221,0.08)";
        ctx.fillRect(x0w, mTop - 4, x1w - x0w, axisY - (mTop - 4));
        ctx.strokeStyle = refOver
          ? isDark ? "rgba(240,149,149,0.5)" : "rgba(163,45,45,0.35)"
          : isDark ? "rgba(55,138,221,0.4)"  : "rgba(55,138,221,0.35)";
        ctx.lineWidth = 1;
        ctx.strokeRect(x0w, mTop - 4, x1w - x0w, axisY - (mTop - 4));

        // "180-day window" label centered just below the overlay's bottom border
        const winMidX = Math.min(Math.max((x0w + x1w) / 2, mL + 60), W - mR - 60);
        ctx.fillStyle = refOver
          ? isDark ? "rgba(240,149,149,0.6)" : "rgba(163,45,45,0.45)"
          : isDark ? "rgba(130,180,240,0.6)" : "rgba(55,138,221,0.45)";
        ctx.font = "500 10px var(--font-sans,sans-serif)";
        ctx.textAlign = "center";
        ctx.fillText("180-day window", winMidX, axisY + 12);

        // Axis
        ctx.strokeStyle = isDark ? "rgba(255,255,255,0.12)" : "rgba(0,0,0,0.1)";
        ctx.lineWidth = 0.5;
        ctx.beginPath(); ctx.moveTo(mL, axisY); ctx.lineTo(W - mR, axisY); ctx.stroke();

        // Month grid lines + labels
        ctx.font = "11px var(--font-sans,sans-serif)";
        ctx.textAlign = "center";
        const cur = new Date(TL_START); cur.setDate(1);
        while (cur <= TL_END) {
          const x = xOf(cur);
          if (x >= mL && x <= W - mR) {
            ctx.strokeStyle = isDark ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.07)";
            ctx.lineWidth = 0.5;
            ctx.beginPath(); ctx.moveTo(x, mTop - 4); ctx.lineTo(x, axisY); ctx.stroke();
            const lx = x + (plotW / TL_TOTAL) * 15;
            if (lx < W - mR - 5) {
              ctx.fillStyle = isDark ? "rgba(255,255,255,0.4)" : "rgba(0,0,0,0.4)";
              ctx.fillText(cur.toLocaleDateString("en-GB", { month: "short" }), lx, axisY + 12);
            }
          }
          cur.setMonth(cur.getMonth() + 1);
        }

        // Trip bars
        trips.forEach((t, i) => {
          const row = getTripRow(t, i);
          const ty = tripAreaTop + row * (tripH + tripGap);
          const x0 = xOf(t.start);
          const x1 = xOf(addDays(t.end, 1));
          const tw = Math.max(x1 - x0, 2);

          ctx.fillStyle = t.color;
          ctx.beginPath(); (ctx as any).roundRect(x0, ty, tw, tripH, 4); ctx.fill();

          const os = t.start > windowStart ? t.start : windowStart;
          const oe = t.end < windowEnd ? t.end : windowEnd;
          if (oe >= os) {
            const xa = xOf(os), xb = xOf(addDays(oe, 1));
            ctx.fillStyle = "rgba(255,255,255,0.22)";
            ctx.beginPath(); (ctx as any).roundRect(xa, ty, xb - xa, tripH, 4); ctx.fill();
          }

          if (tw > 44 && t.showLabel !== false) {
            ctx.fillStyle = "rgba(255,255,255,0.92)";
            ctx.font = "500 11px var(--font-sans,sans-serif)";
            ctx.textAlign = "center";
            ctx.fillText(t.label, x0 + tw / 2, ty + tripH / 2 + 4);
          }
        });

        // Window end dashed line
        const xEnd = xOf(addDays(windowEnd, 1));
        ctx.strokeStyle = isDark ? "rgba(212,83,126,0.85)" : "#d4537e";
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 3]);
        ctx.beginPath(); ctx.moveTo(xEnd, mTop - 4); ctx.lineTo(xEnd, axisY); ctx.stroke();
        ctx.setLineDash([]);

        // Window end date above the dashed line
        ctx.fillStyle = "#d4537e";
        ctx.font = "500 10px var(--font-sans,sans-serif)";
        ctx.textAlign = "center";
        const endLx = Math.min(Math.max(xEnd, mL + 30), W - mR - 30);
        ctx.fillText(fmtShort(windowEnd), endLx, mTop - 8);

        // Window start date above the left edge of the window (only when visible)
        const xWinStart = xOf(windowStart);
        if (xWinStart > mL) {
          ctx.fillStyle = isDark ? "rgba(100,160,230,0.8)" : "rgba(55,138,221,0.7)";
          ctx.font = "500 10px var(--font-sans,sans-serif)";
          ctx.textAlign = "left";
          ctx.fillText(fmtShort(windowStart), xWinStart + 2, mTop - 8);
        }
      }

      function init() {
        descEl.innerHTML = currentScenario.desc;

        const range = computeRange(currentScenario.trips);
        TL_START = range.start; TL_END = range.end; TL_TOTAL = diffDays(TL_START, TL_END);
        slider.min = "179"; slider.max = String(TL_TOTAL - 1);
        const def = diffDays(TL_START, currentScenario.windowDefault);
        slider.value = String(Math.min(Math.max(def, 179), TL_TOTAL - 1));

        canvas.width = Math.max(520, container.clientWidth - 42);
        const windowEnd = addDays(TL_START, parseInt(slider.value));
        drawTimeline(windowEnd);
        renderStats(currentScenario.trips, windowEnd);

        dateLabelEl.textContent = fmtDate(windowEnd);
      }

      slider.addEventListener("input", () => {
        const windowEnd = addDays(TL_START, parseInt(slider.value));
        drawTimeline(windowEnd);
        renderStats(currentScenario.trips, windowEnd);
        dateLabelEl.textContent = fmtDate(windowEnd);
      });

      window.addEventListener("resize", () => {
        canvas.width = Math.max(520, container.clientWidth - 42);
        const windowEnd = addDays(TL_START, parseInt(slider.value));
        drawTimeline(windowEnd);
      });

      init();
    }

    document.querySelectorAll<HTMLElement>(".schengen-explorer[data-scenario]").forEach(initExplorer);
  })();
</script>

