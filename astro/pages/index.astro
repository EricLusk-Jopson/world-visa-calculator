<!--
  Interactive rolling-window demo for the 90/180 Rule section: a draggable
  timeline (pointer + range input + snap buttons) built as a
  <rolling-window-explainer> custom element, progressively enhanced — the
  server-rendered timeline and trips table are fully readable without JS.
-->
<script type="module">
  class RollingWindowExplainer extends HTMLElement {
    dispose;
    connectedCallback() {
      if (this.dispose) return;
      const controller = new AbortController();
      const { signal } = controller;
      let announcementTimer;
      try {
        const config = JSON.parse(this.dataset.config ?? 'null');
        if (!config || !config.trips?.length || config.min > config.max) {
          throw new Error('Invalid timeline configuration.');
        }
        const query = (selector) => {
          const node = this.querySelector(selector);
          if (!node) throw new Error(`Missing timeline element: ${selector}`);
          return node;
        };
        const slider = query('input[type="range"]');
        const plot = query('[data-plot]');
        const windowBand = query('[data-window]');
        const cursor = query('[data-cursor]');
        const live = query('[data-announcement]');
        const buttons = Array.from(this.querySelectorAll('[data-snap]'));
        const span = config.timelineEnd - config.timelineStart;
        const dayMs = 86_400_000;
        const dateOf = (iso) => Date.parse(`${iso}T00:00:00Z`) / dayMs;
        const format = (day) =>
          new Date(day * dayMs).toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
            timeZone: 'UTC',
          });
        const percent = (day) => (100 * (day - config.timelineStart)) / span;
        let pointer = null;

        const update = (rawValue, announce = true) => {
          if (!Number.isFinite(rawValue)) return;
          const selected = Math.max(config.min, Math.min(config.max, Math.round(rawValue)));
          const start = selected - 179;
          const counts = config.trips.map((trip, index) => {
            const overlapStart = Math.max(start, trip.startDay);
            const counted = Math.max(0, Math.min(selected, trip.endDay) - overlapStart + 1);
            const duration = trip.endDay - trip.startDay + 1;
            const bar = query(`[data-bar="${index}"]`);
            bar.style.left = `${counted ? (100 * (overlapStart - trip.startDay)) / duration : 0}%`;
            bar.style.width = `${(100 * counted) / duration}%`;
            query(`[data-trip-count="${index}"]`).textContent = String(counted);
            query(`[data-trip-unit="${index}"]`).textContent = counted === 1 ? 'day' : 'days';
            return counted;
          });
          const used = counts.reduce((sum, count) => sum + count, 0);
          const remaining = Math.max(0, 90 - used);

          slider.value = String(selected);
          slider.setAttribute('aria-valuetext', format(selected));
          query('[data-selected-date]').textContent = format(selected);
          query('[data-used]').textContent = String(used);
          query('[data-remaining]').textContent = String(remaining);
          this.dataset.status = used > 90 ? 'over' : used === 90 ? 'limit' : 'within';
          windowBand.style.left = `${percent(start)}%`;
          cursor.style.left = `${percent(selected + 1)}%`;
          buttons.forEach((button) =>
            button.setAttribute('aria-pressed', String(dateOf(button.dataset.snap) === selected)),
          );

          const tripDescription = config.trips
            .map((trip, i) => `${trip.label}: ${counts[i]} of ${trip.endDay - trip.startDay + 1} days counted.`)
            .join(' ');
          plot.setAttribute(
            'aria-label',
            `Travel timeline. The 180-day window is ${format(start)} to ${format(selected)}. ${tripDescription}`,
          );
          if (announce) {
            clearTimeout(announcementTimer);
            announcementTimer = setTimeout(() => {
              live.textContent = `${format(selected)}. ${tripDescription} ${used} of 90 days used; ${remaining} days remaining in this window.`;
            }, 180);
          }
        };

        slider.addEventListener('input', () => update(Number(slider.value)), { signal });
        buttons.forEach((button) =>
          button.addEventListener('click', () => update(dateOf(button.dataset.snap)), { signal }),
        );

        // Pointer scrubbing is optional; the native range input supplies keyboard access.
        const selectAt = (clientX) => {
          const box = plot.getBoundingClientRect();
          if (box.width > 0) update(config.timelineStart + ((clientX - box.left) / box.width) * span - 1);
        };
        plot.addEventListener(
          'pointerdown',
          (event) => {
            if (!event.isPrimary || event.button !== 0) return;
            pointer = event.pointerId;
            plot.setPointerCapture(pointer);
            selectAt(event.clientX);
          },
          { signal },
        );
        plot.addEventListener(
          'pointermove',
          (event) => {
            if (event.pointerId === pointer) selectAt(event.clientX);
          },
          { signal },
        );
        const release = () => {
          pointer = null;
        };
        plot.addEventListener('pointerup', release, { signal });
        plot.addEventListener('pointercancel', release, { signal });
        plot.addEventListener('lostpointercapture', release, { signal });

        this.dispose = () => {
          controller.abort();
          clearTimeout(announcementTimer);
        };
        update(Number(slider.value), false);
        query('[data-controls]').hidden = false;
        this.dataset.ready = 'true';
      } catch (error) {
        controller.abort();
        clearTimeout(announcementTimer);
        console.error('The rolling-window example could not be initialized.', error);
        // The complete server-rendered timeline and trip table remain readable.
      }
    }
    disconnectedCallback() {
      this.dispose?.();
      this.dispose = undefined;
    }
  }
  if (!customElements.get('rolling-window-explainer')) {
    customElements.define('rolling-window-explainer', RollingWindowExplainer);
  }
</script>

