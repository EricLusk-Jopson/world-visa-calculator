---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingNav from "../components/LandingNav.astro";
import { EuropeCoverageIsland } from "@/islands/EuropeCoverageIsland";
---

<BaseLayout
  title="EuroVisaCalculator: Travel Europe Visa-Free Without The Risk Of An Overstay."
  description="Check visa-free entry and track day allowances across Europe for any passport and every traveler in your group. Free, no account required."
>
  <LandingNav />

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <!-- Left column — static copy -->
    <div class="hero__left">
      <!-- Eyebrow badge -->
      <div class="eyebrow">
        <span class="eyebrow__dot"></span>
        Free · Private · No account required
      </div>

      <!-- Heading -->
      <h1 class="hero__h1">
        Travel Europe indefinitely, <em>without the overstay risk.</em>
      </h1>

      <!-- Sub-copy -->
      <p class="hero__sub">
        Check visa and entry requirements for Schengen, the UK, Ireland, and
        Türkiye, for any passport and any traveler. Add trips, see remaining
        days, and plan without guessing.
      </p>

      <!-- Mobile-only CTA — the interactive map demo is hidden on
           mobile, so this replaces it as the primary call to action. -->
      <a href="/app" class="btn-green hero__mobile-cta">
        Open the calculator →
      </a>

      <!-- Proof items -->
      <div class="proof-items">
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1L9.8 5.8L15 6.2L11.2 9.6L12.4 15L8 12.4L3.6 15L4.8 9.6L1 6.2L6.2 5.8L8 1Z" />
          </svg>
          Official Schengen rolling-window algorithm
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8C2 4.686 4.686 2 8 2s6 2.686 6 6-2.686 6-6 6-6-2.686-6-6z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5.5 8l2 2L11 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Multiple travelers, one view
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M2 8C2 4.686 4.686 2 8 2s6 2.686 6 6-2.686 6-6 6-6-2.686-6-6z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          URL-shareable results
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="4" y="7" width="8" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Your data never leaves your device
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2l1.5 4.5H14l-3.75 2.75L11.5 14 8 11.25 4.5 14l1.25-4.75L2 6.5h4.5L8 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          </svg>
          Entry rules for 198 passports
        </span>
      </div>
    </div>

    <!-- Right column — interactive coverage map -->
    <div class="hero__right">
      <EuropeCoverageIsland client:visible />
    </div>
  </section>

  <!-- ── FEATURES ─────────────────────────────────────────────────────────── -->
  <section id="features" class="features">
    <div class="features__inner">
      <!-- Left column -->
      <div class="features__left">
        <p class="section-tag section-tag--light">Features</p>
        <h2 class="section-heading section-heading--light">
          Built for long-term,<br />
          frequent, and <em>social travelers.</em>
        </h2>
        <p class="section-sub section-sub--light">
          Most Schengen calculators handle a single traveler, on a single
          trip, to a single region with no way to check whether your
          passport even qualifies for visa-free entry. We built EuroVisaCalculator for
          real, long-term, multi-country travel with other travelers.
        </p>
        <a href="/app" class="btn-green" style="margin-top:36px;">
          Try it free →
        </a>
      </div>

      <!-- Right column — feature list -->
      <div class="features__right">
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 9C2 5.134 5.134 2 9 2s7 3.134 7 7-3.134 7-7 7-7-3.134-7-7z" stroke="currentColor" stroke-width="1.4"/>
              <path d="M5.5 9l2.5 2.5L13 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Official rules for every destination</p>
            <p class="feature-item__desc">Most destinations in Europe follow a 90/180 rolling-window rule, which we implement exactly, according to the official documentation.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="10" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="2" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="10" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Multiple travelers, one dashboard</p>
            <p class="feature-item__desc">Track couples, families, or friends, each with their own schedule, in a single shared view. Shareable via URL.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M9 2v4M9 12v4M2 9h4M12 9h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Earliest return date calculator</p>
            <p class="feature-item__desc">After leaving, see the earliest date you can return for a given number of days. Stops you booking flights that will get rejected at the border.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="4" y="2" width="10" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="9" cy="7" r="1.8" stroke="currentColor" stroke-width="1.4"/>
              <path d="M6.5 12h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Visa &amp; entry requirements, per passport</p>
            <p class="feature-item__desc">Check visa requirements, pre-travel authorizations and maximum stay lengths for your passport. All supported destinations feature links to their government's official visa regimes.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 9.5l5-5 3 4 3-3 3 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Live validation &amp; overstay warnings</p>
            <p class="feature-item__desc">Automated compliance checks for each traveler added to a trip.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="4" y="8" width="10" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M6.5 8V6a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Completely private, no backend</p>
            <p class="feature-item__desc">Trips are saved in your browser and encoded in the URL. No account needed and no server ever stores your data.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ─────────────────────────────────────────────────────── -->
  <section id="how" class="how">
    <div class="how__inner">
      <p class="section-tag">How it works</p>
      <h2 class="section-heading">
        Simple enough to use<br />
        in <em>thirty seconds.</em>
      </h2>
      <p class="section-sub">
        No spreadsheets. No manual math. Just add your trips and get a clear answer.
      </p>

      <div class="steps-grid">
        <!-- Step 01 -->
        <div class="step-card">
          <span class="step-card__num">01</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="7" r="3" stroke="currentColor" stroke-width="1.5"/>
              <path d="M4 17c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Add your travelers</h3>
          <p class="step-card__desc">Enter names for everyone you want to track: yourself, a partner, family, or a group of friends.</p>
        </div>
        <!-- Step 02 -->
        <div class="step-card step-card--border-left">
          <span class="step-card__num">02</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="3" y="4" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 9h14" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7 2v4M13 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Add Your Trips</h3>
          <p class="step-card__desc">Add each trip to the destination it belongs to, with an entry and exit date. Planned future trips show up too.</p>
        </div>
        <!-- Step 03 -->
        <div class="step-card step-card--border-left">
          <span class="step-card__num">03</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 6v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Check Your Compliance</h3>
          <p class="step-card__desc">See visa eligibility, duration limits, and overstay risk for every traveler, updated instantly as you add trips.</p>
        </div>
        <!-- Step 04 -->
        <div class="step-card step-card--border-left">
          <span class="step-card__num">04</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="15" cy="5" r="2" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="5" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="15" cy="15" r="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M6.8 9l6.4-3M6.8 11l6.4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Share Your Results</h3>
          <p class="step-card__desc">Copy the link and send it to everyone you're traveling with. They'll see exactly what you see, with no login required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── RULES EXPLAINER ──────────────────────────────────────────────────── -->
  <section id="rules" class="rules">
    <div class="rules__inner">
      <!-- Left: text -->
      <div class="rules__text">
        <p class="section-tag">The 90/180 Rule</p>
        <h2 class="section-heading section-heading--light">
          90/180 <em>Is Not Just Schengen.</em>
        </h2>
        <p class="section-sub section-sub--light">
          The 90/180 is most often mentioned in reference to the Schengen
          Area, but it's far from unique to Schengen. In fact, the rule is
          enforced across most European countries, even outside the Schengen
          block, so it's worth understanding.
        </p>
        <p class="rules__body">
          The rule applies to a rolling 180-day window. At any given moment,
          look back 180 days. If you've spent 90 or more days inside during
          that window, you've overstayed. As time passes, old trips begin to
          fall outside of the window and no longer count against your
          allowance.
        </p>
        <p class="rules__body">
          To better understand the rule, read our
          <a href="/blog/the-schengen-90-180-rolling-window">full guide to the 90/180 rolling window</a>
          for a walkthrough of real scenarios.
        </p>
      </div>

      <!-- Right: interactive demo — draggable rolling-window explainer, same
           two-trip scenario (Trip 1: Mar 1–May 29 2025, Trip 2: Sep 7–Dec 5
           2025) as before, now with a draggable timeline, snap buttons, and
           a full trips table. Progressively enhanced: the full server-
           rendered timeline and trip table stay readable without JS. -->
      <rolling-window-explainer
        class="schengen-explorer"
        data-config='{"trips":[{"label":"Trip 1","start":"2025-03-01","end":"2025-05-29","startDay":20148,"endDay":20237},{"label":"Trip 2","start":"2025-09-07","end":"2025-12-05","startDay":20338,"endDay":20427}],"timelineStart":19953,"timelineEnd":20622,"min":20132,"max":20621,"initial":20338}'
      >
        <figure class="explainer-timeline">
          <figcaption>
            <span>Travel timeline</span>
            <span class="explainer-timeline-key"><i aria-hidden="true"></i>Counted days</span>
          </figcaption>
          <div
            class="explainer-plot"
            data-plot="true"
            role="img"
            aria-label="Travel timeline. The 180-day window is 12 Mar 2025 to 7 Sept 2025. Trip 1: 79 of 90 days counted. Trip 2: 1 of 90 days counted."
          >
            <div class="explainer-window" data-window="true" style="left:30.79222720478326%;width:26.905829596412556%">
              <span>180-day window</span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="false" data-month-day="19967" style="left:2.092675635276532%" title="1 Sept 2024" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Sept</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="true" data-month-day="19997" style="left:6.576980568011958%" title="1 Oct 2024" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Oct</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="false" data-month-day="20028" style="left:11.210762331838565%" title="1 Nov 2024" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Nov</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="false" data-month-day="20058" style="left:15.695067264573991%" title="1 Dec 2024" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Dec</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="true" data-month-day="20089" style="left:20.328849028400597%" title="1 Jan 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Jan</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="false" data-month-day="20120" style="left:24.962630792227205%" title="1 Feb 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Feb</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="false" data-month-day="20148" style="left:29.14798206278027%" title="1 Mar 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Mar</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="true" data-month-day="20179" style="left:33.78176382660688%" title="1 Apr 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Apr</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="false" data-month-day="20209" style="left:38.2660687593423%" title="1 May 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>May</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="false" data-month-day="20240" style="left:42.89985052316891%" title="1 Jun 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Jun</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="true" data-month-day="20270" style="left:47.384155455904335%" title="1 Jul 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Jul</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="false" data-month-day="20301" style="left:52.01793721973094%" title="1 Aug 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Aug</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="false" data-month-day="20332" style="left:56.65171898355755%" title="1 Sept 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Sept</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="true" data-month-day="20362" style="left:61.13602391629298%" title="1 Oct 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Oct</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="false" data-month-day="20393" style="left:65.76980568011957%" title="1 Nov 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Nov</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="false" data-month-day="20423" style="left:70.254110612855%" title="1 Dec 2025" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Dec</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="true" data-month-day="20454" style="left:74.88789237668162%" title="1 Jan 2026" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Jan</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="false" data-month-day="20485" style="left:79.52167414050822%" title="1 Feb 2026" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Feb</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="false" data-month-day="20513" style="left:83.70702541106128%" title="1 Mar 2026" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Mar</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="true" data-month-day="20544" style="left:88.34080717488789%" title="1 Apr 2026" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Apr</span></span>
            </div>
            <div class="explainer-tick" data-alternate="true" data-quarterly="false" data-month-day="20574" style="left:92.82511210762331%" title="1 May 2026" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>May</span></span>
            </div>
            <div class="explainer-tick" data-alternate="false" data-quarterly="false" data-month-day="20605" style="left:97.45889387144993%" title="1 Jun 2026" aria-hidden="true">
              <span class="explainer-tick-label"><span>1</span> <span>Jun</span></span>
            </div>
            <div class="explainer-track" aria-hidden="true">
              <div class="explainer-trip-bar" style="left:29.14798206278027%;width:13.452914798206278%">
                <span class="explainer-trip-counted" data-bar="0" style="left:12.222222222222221%;width:87.77777777777777%"></span>
                <span class="explainer-trip-bar-label"><span class="explainer-bar-name">Trip 1</span><span>90d</span></span>
              </div>
              <div class="explainer-trip-bar" style="left:57.54857997010463%;width:13.452914798206278%">
                <span class="explainer-trip-counted" data-bar="1" style="left:0%;width:1.1111111111111112%"></span>
                <span class="explainer-trip-bar-label"><span class="explainer-bar-name">Trip 2</span><span>90d</span></span>
              </div>
            </div>
            <div class="explainer-cursor" data-cursor="true" style="left:57.69805680119581%" aria-hidden="true"><span></span></div>
            <div class="explainer-years" aria-hidden="true">
              <span style="left:0%;width:20.328849028400597%">2024</span>
              <span style="left:20.328849028400597%;width:54.559043348281016%">2025</span>
              <span style="left:74.88789237668162%;width:25.112107623318387%">2026</span>
            </div>
          </div>
        </figure>
        <div class="explainer-controls" data-controls="true" hidden>
          <label class="explainer-slider-label">
            <span class="explainer-slider-heading">
              <span>Move the date</span>
              <output data-selected-date="true">7 Sept 2025</output>
            </span>
            <input type="range" min="20132" max="20621" step="1" value="20338" aria-label="Window end date" aria-valuetext="7 Sept 2025" />
          </label>
        </div>
        <noscript><p class="explainer-nojs">Showing 7 Sept 2025. Enable JavaScript to move the window.</p></noscript>
        <dl class="explainer-stats">
          <div>
            <dt>Days in window</dt>
            <dd><strong data-used="true">80</strong><span> / 90</span></dd>
          </div>
          <div>
            <dt>Remaining allowance</dt>
            <dd><strong data-remaining="true">10</strong><span> days</span></dd>
          </div>
        </dl>
        <table class="explainer-trips">
          <caption class="explainer-sr-only">Trip durations and the days counted in the selected window</caption>
          <thead>
            <tr>
              <th scope="col">Your trips</th>
              <th scope="col">Full trip</th>
              <th scope="col">In window</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">
                <span class="explainer-trip-name">Trip 1</span>
                <span class="explainer-trip-dates">1 Mar – 29 May 2025</span>
              </th>
