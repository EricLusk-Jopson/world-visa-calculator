---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingNav from "../components/LandingNav.astro";
import { HeroCalculatorIsland } from "@/islands/HeroCalculatorIsland";
---

<BaseLayout
  title="EuroVisaCalculator: Schengen, UK, Ireland & Türkiye Visa Tracker"
  description="Check visa-free entry and track day allowances across Schengen, the UK, Ireland, and Türkiye, for any passport and every traveler in your group. Free, no account required."
>
  <LandingNav />

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="hero">
    <!-- Left column — static copy -->
    <div class="hero__left">
      <!-- Eyebrow badge -->
      <div class="eyebrow">
        <span class="eyebrow__dot"></span>
        Free · Private · No account required · Works instantly
      </div>

      <!-- Heading -->
      <h1 class="hero__h1">
        Travel Europe indefinitely, <em>without the overstay risk.</em>
      </h1>

      <!-- Sub-copy -->
      <p class="hero__sub">
        Check visa and entry requirements for Schengen, the UK, Ireland, and
        Türkiye, for any passport and any traveler. Add trips, see remaining
        days, and plan without guessing.
      </p>

      <!-- Mobile-only CTA — the interactive calculator demo is hidden on
           mobile, so this replaces it as the primary call to action. -->
      <a href="/app" class="btn-green hero__mobile-cta">
        Open the calculator →
      </a>

      <!-- Proof items -->
      <div class="proof-items">
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1L9.8 5.8L15 6.2L11.2 9.6L12.4 15L8 12.4L3.6 15L4.8 9.6L1 6.2L6.2 5.8L8 1Z" />
          </svg>
          Official Schengen rolling-window algorithm
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 8C2 4.686 4.686 2 8 2s6 2.686 6 6-2.686 6-6 6-6-2.686-6-6z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5.5 8l2 2L11 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Multiple travelers, one view
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M2 8C2 4.686 4.686 2 8 2s6 2.686 6 6-2.686 6-6 6-6-2.686-6-6z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          URL-shareable results
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="4" y="7" width="8" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Your data never leaves your device
        </span>
        <span class="proof-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2l1.5 4.5H14l-3.75 2.75L11.5 14 8 11.25 4.5 14l1.25-4.75L2 6.5h4.5L8 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          </svg>
          Entry rules for 198 passports
        </span>
      </div>
    </div>

    <!-- Right column — interactive calculator card -->
    <div class="hero__right">
      <HeroCalculatorIsland client:visible />
    </div>
  </section>

  <!-- ── TRUST STRIP ──────────────────────────────────────────────────────── -->
  <section class="trust-strip" aria-label="Key statistics">
    <div class="trust-strip__grid">
      <div class="trust-stat">
        <span class="trust-stat__num">4</span>
        <span class="trust-stat__label">official rule systems<br />one calculator</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat__num">32</span>
        <span class="trust-stat__label">European destinations<br />Schengen, UK, Ireland &amp; Türkiye</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat__num">198</span>
        <span class="trust-stat__label">passports<br />with entry rules covered</span>
      </div>
      <div class="trust-stat">
        <span class="trust-stat__num">0</span>
        <span class="trust-stat__label">bytes of your data<br />sent to any server</span>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ─────────────────────────────────────────────────────── -->
  <section id="how" class="how">
    <div class="how__inner">
      <p class="section-tag">How it works</p>
      <h2 class="section-heading">
        Simple enough to use<br />
        in <em>thirty seconds.</em>
      </h2>
      <p class="section-sub">
        No spreadsheets. No manual math. Just add your trips and get a clear answer.
      </p>

      <div class="steps-grid">
        <!-- Step 01 -->
        <div class="step-card">
          <span class="step-card__num">01</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="7" r="3" stroke="currentColor" stroke-width="1.5"/>
              <path d="M4 17c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Add your travelers</h3>
          <p class="step-card__desc">Enter names for everyone you want to track: yourself, a partner, family, or a group of friends.</p>
        </div>
        <!-- Step 02 -->
        <div class="step-card step-card--border-left">
          <span class="step-card__num">02</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="3" y="4" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M3 9h14" stroke="currentColor" stroke-width="1.5"/>
              <path d="M7 2v4M13 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Add Your Trips</h3>
          <p class="step-card__desc">Add each trip to the destination it belongs to, with an entry and exit date. Planned future trips show up too.</p>
        </div>
        <!-- Step 03 -->
        <div class="step-card step-card--border-left">
          <span class="step-card__num">03</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 6v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Check Your Compliance</h3>
          <p class="step-card__desc">See visa eligibility, duration limits, and overstay risk for every traveler, updated instantly as you add trips.</p>
        </div>
        <!-- Step 04 -->
        <div class="step-card step-card--border-left">
          <span class="step-card__num">04</span>
          <div class="step-card__icon">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="15" cy="5" r="2" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="5" cy="10" r="2" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="15" cy="15" r="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M6.8 9l6.4-3M6.8 11l6.4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <h3 class="step-card__title">Share Your Results</h3>
          <p class="step-card__desc">Copy the link and send it to everyone you're traveling with. They'll see exactly what you see, with no login required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FEATURES ─────────────────────────────────────────────────────────── -->
  <section id="features" class="features">
    <div class="features__inner">
      <!-- Left column -->
      <div class="features__left">
        <p class="section-tag section-tag--light">Features</p>
        <h2 class="section-heading section-heading--light">
          Built for long-term,<br />
          frequent, and <em>social travelers.</em>
        </h2>
        <p class="section-sub section-sub--light">
          Most travel calculators only handle a single traveler, on a single
          trip, to a single country, with no way to check whether your
          passport even qualifies for visa-free entry. We built this for
          real, long-term, multi-country travel.
        </p>
        <a href="/app" class="btn-green" style="margin-top:36px;">
          Try it free →
        </a>
      </div>

      <!-- Right column — feature list -->
      <div class="features__right">
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 9C2 5.134 5.134 2 9 2s7 3.134 7 7-3.134 7-7 7-7-3.134-7-7z" stroke="currentColor" stroke-width="1.4"/>
              <path d="M5.5 9l2.5 2.5L13 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Official rules for every destination</p>
            <p class="feature-item__desc">Schengen and Türkiye share the same 90/180 rolling-window rule, which we implement exactly: any 180-day lookback, counting both entry and exit days, verified against the official EU calculator. The UK and Ireland each have their own official entry rules, which we support too.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="10" y="2" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="2" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="10" y="10" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Multiple travelers, one dashboard</p>
            <p class="feature-item__desc">Track couples, families, or groups of travelers from different countries of origin, each with their own schedule, in a single shared view. Shareable via URL.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M9 2v4M9 12v4M2 9h4M12 9h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              <circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Earliest return date calculator</p>
            <p class="feature-item__desc">After leaving, see the earliest date you can return for a given number of days. Stops you booking flights that will get rejected at the border.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="4" y="2" width="10" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <circle cx="9" cy="7" r="1.8" stroke="currentColor" stroke-width="1.4"/>
              <path d="M6.5 12h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Visa &amp; entry requirements, per passport</p>
            <p class="feature-item__desc">Every traveler's passport is checked against each destination's rules: visa requirements, pre-travel authorizations like ETIAS or an ETA, and maximum stay lengths. Restrictions are flagged before you book, not after.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M2 9.5l5-5 3 4 3-3 3 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Live validation &amp; overstay warnings</p>
            <p class="feature-item__desc">Calendar cells are color-coded as you pick dates: green for safe, yellow for caution, red for over the limit. Alerts fire before you save a trip that would push you over the limit, so there are no surprises after you click confirm.</p>
          </div>
        </div>
        <div class="feature-item">
          <div class="feature-item__icon">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <rect x="4" y="8" width="10" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M6.5 8V6a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <p class="feature-item__title">Completely private, no backend</p>
            <p class="feature-item__desc">Your trips are saved in your browser's local storage and encoded in the URL. No account needed and no server ever sees your travel history. Works offline once the app is loaded. Share the link and everyone you're traveling with sees exactly what you see.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── RULES EXPLAINER ──────────────────────────────────────────────────── -->
  <section id="rules" class="rules">
    <div class="rules__inner">
      <!-- Left: text -->
      <div class="rules__text">
        <p class="section-tag">Schengen's 90/180 Rule</p>
        <h2 class="section-heading">
          It's not "90 days<br />
          then leave for 90." <em>It's more complex.</em>
        </h2>
        <p class="section-sub">
          The rule applies to a <strong>rolling 180-day window</strong>, not
          fixed half-years. At any given moment, look back 180 days. If you've
          spent 90 or more days inside during that window, you're non-compliant.
          It's not unique to Schengen, either. Türkiye uses the identical
          90/180 rolling window, so the same logic applies there too.
        </p>
        <p class="rules__body">
          This means days "roll off" your count as time passes, which can free
          up allowance much earlier than most travelers expect, but also requires multiple calculations, and
          miscalculations happen easily, in Schengen or Türkiye alike. Read our
          <a href="/blog/the-schengen-90-180-rolling-window">full guide to the 90/180 rolling window</a>
          for a walkthrough of real scenarios.
        </p>
        <a href="/app" class="btn-green" style="margin-top:32px;">
          Calculate my days →
        </a>
      </div>

      <!-- Right: demo card -->
      <div class="allowance-card">
        <!-- Card header — mimics browser chrome -->
        <div class="allowance-card__header">
          <span class="traffic-dot traffic-dot--red"></span>
          <span class="traffic-dot traffic-dot--amber"></span>
          <span class="traffic-dot traffic-dot--green"></span>
          <span class="allowance-card__label">Traveler status · today</span>
        </div>

        <!-- Allowance bars -->
        <div class="allowance-bars">
          <!-- Emma — safe (43/90, 47 remaining) -->
          <div class="allowance-row">
            <span class="allowance-name">Emma</span>
            <div class="allowance-track" role="progressbar" aria-valuenow="43" aria-valuemax="90" aria-label="Emma: 43 of 90 days used">
              <div class="allowance-fill allowance-fill--safe" style="width:43%"></div>
            </div>
            <span class="allowance-badge allowance-badge--safe">47 days left</span>
          </div>
          <!-- Liam — caution (76/90, 14 remaining) -->
          <div class="allowance-row">
            <span class="allowance-name">Liam</span>
            <div class="allowance-track" role="progressbar" aria-valuenow="76" aria-valuemax="90" aria-label="Liam: 76 of 90 days used">
              <div class="allowance-fill allowance-fill--caution" style="width:76%"></div>
            </div>
            <span class="allowance-badge allowance-badge--caution">14 days left</span>
          </div>
          <!-- Sofia — danger (88/90, 2 remaining) -->
          <div class="allowance-row">
            <span class="allowance-name">Sofia</span>
            <div class="allowance-track" role="progressbar" aria-valuenow="88" aria-valuemax="90" aria-label="Sofia: 88 of 90 days used">
              <div class="allowance-fill allowance-fill--danger" style="width:88%"></div>
            </div>
            <span class="allowance-badge allowance-badge--danger">2 days left</span>
          </div>
        </div>

        <!-- Rule pills -->
        <div class="rule-pills">
          <span class="rule-pill">Rolling 180-day window</span>
          <span class="rule-pill">Used by Schengen &amp; Türkiye</span>
          <span class="rule-pill">Entry + exit days count</span>
          <span class="rule-pill">No fixed reset date</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA BAND ─────────────────────────────────────────────────────────── -->
  <section class="cta-band">
    <div class="cta-band__inner">
      <h2 class="cta-band__heading">
        Stop guessing.<br />
        Start tracking <em>in seconds.</em>
      </h2>
      <p class="cta-band__sub">
        Free, no account required. Your trip data is stored in your browser,
        never on our servers. Add travelers, enter your trips, and share
        a link with everyone you're traveling with, immediately.
      </p>
      <div class="cta-band__actions">
        <a href="/app" class="btn-green">
          Open the calculator →
        </a>
        <a href="/blog" class="btn-ghost">
          Read our guides →
        </a>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ────────────────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="footer__inner">
      <div class="footer__top">
        <div class="footer__identity">
          <span class="footer__brand">EuroVisaCalculator</span>
          <a
            href="https://ko-fi.com/ericluskjopson"
            class="footer__kofi"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/>
            </svg>
            Support This Project
          </a>
        </div>
        <nav class="footer__links" aria-label="Footer navigation">
          <a href="/privacy" class="footer__link">Privacy</a>
          <a href="/updates" class="footer__link">Updates</a>
          <a href="/blog" class="footer__link">Blog</a>
          <a href="#how" class="footer__link">How it works</a>
          <a href="/app" class="footer__link">Calculator</a>
        </nav>
      </div>
      <p class="footer__disclaimer">
        For informational use only. Always verify with official government sources
        before making travel decisions.
        Not legal advice. Entry and visa rules vary by nationality and destination.
      </p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ── Hero layout ────────────────────────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  @media (min-width: 900px) {
    .hero {
      flex-direction: row;
    }
  }

  /* ── Left column ────────────────────────────────────────────────────────── */
  .hero__left {
    padding: 60px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
  }

  @media (min-width: 900px) {
    .hero__left {
      flex: 1;
      padding: 80px 80px;
    }
  }

  /* Center the hero content (title, description, CTA, proof items) as a
     block on mobile. Desktop keeps the left-aligned layout. */
  @media (max-width: 899px) {
    .hero__left {
      align-items: center;
      text-align: center;
    }
  }

  /* ── Right column ──────────────────────────────────────────────────────── */
  .hero__right {
    background: var(--color-white);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
  }

  @media (min-width: 900px) {
    .hero__right {
      flex: 1;
      border-top: none;
      border-left: 1px solid var(--color-border);
      padding: 80px 60px;
    }
  }

  /* The interactive calculator demo is desktop-only — on mobile it's
     replaced by .hero__mobile-cta below the hero copy. */
  @media (max-width: 899px) {
    .hero__right {
      display: none;
    }
  }

  /* ── Eyebrow badge ──────────────────────────────────────────────────────── */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-green);
    background: var(--color-green-bg);
    padding: 5px 14px;
    border-radius: 100px;
    width: fit-content;
    border: 1px solid var(--color-green-border);
    animation: fadeUp 0.5s 0.1s both ease-out;
  }

  /* Eyebrow is desktop-only — it wraps awkwardly at narrow widths and the
     new mobile CTA button below covers the same "free / private / no
     account" messaging via the CTA band further down the page. */
  @media (max-width: 899px) {
    .eyebrow {
      display: none;
    }
  }

  /* ── Mobile-only hero CTA ───────────────────────────────────────────────── */
  /* Double class for specificity: must beat .btn-green's own unconditional
     `display: inline-flex`, which is declared later in this stylesheet. */
  .hero__mobile-cta.btn-green {
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 40%;
    padding: 16px 32px;
    font-size: 1.05rem;
    animation: fadeUp 0.6s 0.35s both ease-out;
  }

  @media (min-width: 900px) {
    /* Double class for specificity: must beat .btn-green's own unconditional
       `display: inline-flex`, which is declared later in this stylesheet. */
    .hero__mobile-cta.btn-green {
      display: none;
    }
  }

  .eyebrow__dot {
    width: 7px;
    height: 7px;
    background: var(--color-green);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── Heading ────────────────────────────────────────────────────────────── */
  .hero__h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 4.5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.12;
    color: var(--color-navy);
    letter-spacing: -0.01em;
    margin: 0;
    animation: fadeUp 0.6s 0.2s both ease-out;
  }

  .hero__h1 em {
    font-style: italic;
    color: var(--color-green);
  }

  /* ── Sub-copy ───────────────────────────────────────────────────────────── */
  .hero__sub {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-soft);
    max-width: 440px;
    margin: 0;
    animation: fadeUp 0.6s 0.3s both ease-out;
  }

  /* ── Proof items ────────────────────────────────────────────────────────── */
  .proof-items {
    display: flex;
