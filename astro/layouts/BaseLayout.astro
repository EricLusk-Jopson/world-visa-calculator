---
import "@/styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "EuroVisaCalculator — Schengen, UK, Ireland & Türkiye Visa Tracker",
  description = "Check visa-free entry and track day allowances across Schengen, the UK, Ireland, and Türkiye — for any passport, and every traveler in your group. Free, no account required.",
  canonicalUrl = "https://eurovisacalculator.com/",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ── Google Search Console verification ──────────────────────────────── -->
    <meta name="google-site-verification" content="9DuKyzXPa-bHZ6MP46KOf7z9n0KLoEnTwIAYeP7iWc8" />

    <!-- ── Favicon ──────────────────────────────────────────────────────── -->
    <link rel="icon" type="image/svg+xml" href="/geo-dark.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- ── Primary SEO ──────────────────────────────────────────────────── -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- ── Open Graph (Facebook, LinkedIn, WhatsApp previews) ───────────── -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://eurovisacalculator.com/og-image.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="EuroVisaCalculator" />

    <!-- ── Twitter / X card ─────────────────────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://eurovisacalculator.com/og-image.png"
    />

    <!-- ── Structured data (Google rich results) ────────────────────────── -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "EuroVisaCalculator",
        "url": "https://eurovisacalculator.com",
        "description": "Free visa and day-allowance tracker for Schengen, the UK, Ireland, and Türkiye. Check entry requirements for any passport, track multiple travelers, and share results instantly.",
        "applicationCategory": "TravelApplication",
        "operatingSystem": "Any",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    </script>

    <!-- ── Fonts ─────────────────────────────────────────────────────────── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
