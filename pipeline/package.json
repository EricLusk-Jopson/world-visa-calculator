{
  "name": "eurovisa-pipeline",
  "private": true,
  "version": "1.0.0",
  "description": "Biweekly source verification pipeline for EuroVisaCalculator: link health + content/link-target diffing over src/data/sources.ts, with a standardized by-region report.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "check": "tsx src/checkAll.ts",
    "demo": "tsx src/demoRun.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "undici": "^7.30.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3"
  }
}
