    "content": "<div style=\"text-align: center;\"><span style=\"font-family:arial,helvetica,sans-serif\"><span style=\"font-size:14px\"><span style=\"color:#000000\">Citizens and stateless persons permanently residing in the countries listed below may enter and/or stay in Georgia, or transit the territory of Georgia&nbsp;without a visa.</span></span></span></div>\r\n\r\n<div style=\"text-align: justify;\">&nbsp;</div>\r\n\r\n<table border=\"0\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-color:black; height:0px; width:100%\">\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t\t<td colspan=\"2\" rowspan=\"1\" style=\"background-color:rgb(48, 83, 122)\">\r\n\t\t\t<div style=\"text-align: center;\"><span style=\"color:#FFFFFF\"><span style=\"font-size:14px\"><strong><span style=\"font-family:arial,helvetica,sans-serif\">Country</span></strong></span></span></div>\r\n\t\t\t</td>\r\n\t\t\t<td style=\"background-color:rgb(48, 83, 122)\">\r\n\t\t\t<div style=\"text-align: center;\"><span style=\"color:#FFFFFF\"><span style=\"font-size:14px\"><strong><span style=\"font-family:arial,helvetica,sans-serif\">The maximum period of stay without visa</span></strong></span></span></div>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td style=\"background-color:rgb(222, 222, 222)\">\r\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"color:#000000\"><img alt=\"\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAAAwCAYAAAChS3wf\" style=\"height:26px; width:35px\" /></span></span></div>\r\n\t\t\t</td>\r\n\t\t\t<td style=\"background-color:rgb(222, 222, 222)\">\r\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"color:#000000\"><span style=\"font-family:arial,helvetica,sans-serif\">Albania</span></span></span></div>\r\n\t\t\t</td>\r\n\t\t\t<td style=\"background-color:rgb(222, 222, 222)\">\r\n\t\t\t<div style=\"text-align: center;\"><span style=\"font-size:14px\"><span style=\"color:#000000\">Full 1 (one) year</span></span></div>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td>\r\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"color:#000000\"><img alt=\"\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAAAwCAYAAAChS3wf\" style=\"height:26px; width:35px\" /></span></span></div>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"color:#000000\"><span style=\"font-family:arial,helvetica,sans-serif\">Austria*</span></span></span></div>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t<div style=\"text-align: center;\"><span style=\"font-size:14px\"><span style=\"color:#000000\">Full 1 (one) year</span></span></div>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td style=\"background-color:rgb(222, 222, 222); text-align:center\">\r\n\t\t\t<div><img alt=\"\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAAAwCAYAAAChS3wf\" style=\"height:26px; width:35px\" /></div>\r\n\t\t\t</td>\r\n\t\t\t<td style=\"background-color:rgb(222, 222, 222)\">\r\n\t\t\t<div><span style=\"font-size:14px\"><span style=\"color:#000000\"><span style=\"font-family:arial,helvetica,sans-serif\">Chile</span></span></span></div>\r\n\t\t\t</td>\r\n\t\t\t<td style=\"background-color:rgb(222, 222, 222)\">\r\n\t\t\t<div style=\"text-align: center;\"><span style=\"font-size:14px\"><span style=\"color:#000000\"><span style=\"font-family:arial,helvetica,sans-serif\">90 days in any </span></span></span></div>\r\n\r\n\t\t\t<div style=\"text-align: center;\"><span style=\"font-size:14px\"><span style=\"color:#000000\"><span style=\"font-family:arial,helvetica,sans-serif\">180 day period&nbsp;</span></span></span></div>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<td style=\"border-color:black; height:0px; text-align:center; width:0px\">\r\n\t\t\t<p><img alt=\"\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAAAwCAYAAAChS3wf\" style=\"height:26px; width:35px\" /></p>\r\n\r\n\t\t\t<div>&nbsp;</div>\r\n\t\t\t</td>\r\n\t\t\t<td style=\"border-color:black; height:0px; width:0px\">\r\n\t\t\t<div>&nbsp;</div>\