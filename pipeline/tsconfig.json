{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      // Modules shared from ../src import packages that CI installs only
      // here, not at the repo root, so resolve them from this package (the
      // package dir for tsc's types, its entry file for tsx at runtime).
      "yaml": ["./node_modules/yaml", "./node_modules/yaml/dist/index.js"]
    }
  },
  "include": ["src"]
}
